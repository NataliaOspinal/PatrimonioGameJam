  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Para Mart\xEDn, mi querido nieto;\n\r\nSi estas l\xEDneas han llegado
    a tus manos, estar\xE1s ya pr\xF3ximo a partir.\n\r\nNo pretendo apartarte de
    tu viaje ni pedirte que permanezcas en Lima, s\xE9 lo importante que es viajar
    a C\xE1diz para ti. Te ruego \xFAnicamente una cosa antes de marcharte: averigua
    por qu\xE9 nuestra familia decidi\xF3 conservar cuanto hallar\xE1s en este ba\xFAl.\n\r\nAlgunas
    de sus historias me fueron contadas con claridad y otras llegaron a m\xED incompletas.
    Tu madre conoce una parte. Don Tom\xE1s Valverde conserva otra por encargo m\xEDo.
    \n\tNo me gustar\xEDa que te fueras sin antes \tentender qui\xE9n eres.\r\n\tPregunta
    antes de decidir qu\xE9 llevar \t\tcontigo, aunque entiendo si deseas \t\tno
    hacerlo, all\xE1 estar\xE1s muy ocupado.\n\r\n\t\t\tTu abuela,\r\n\t\t\t\tIsabel"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9756343b567766b498d6bcabdc47249a, type: 2}
